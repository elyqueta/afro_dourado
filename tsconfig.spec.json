{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "vitest/globals"
    ],
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts"
  ]
}
